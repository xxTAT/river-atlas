/sequence { (\
CUUUGGAGAUUUUAUUAUUACACAACCAGGUAAUGGAUGUGUGGACUUAGCAUCCUAUUAUUCUUAUUUAAUGCCCAUUAUG GUCCAGACAGUGGGUGUACACUUGAAAGAACUUGGUAUAGUCCUUAACGAGGACGUUACCAC\
) } def
/len { sequence length } bind def

