GGCGUAUAACGUCAUUGGCUAUGUCAUAUGUGUUCGAUUUGGCCUUAUGUGGCUUGCAAAUCGGUUCACAACUGUACCUAUGGGCACAUACCAGUAUAUGGUGUCUGUAGAGCAACUUAAGUACAUGAUGGCAGUUAAGAUGUCCCCACCGCGUAAUGCGUUUGAGGUGCUU AAAAUUCUUGAUGCAAAAGCUACUGCUGUUGUUGUUGCUAACCUUCUUGAAAAGGCUGGCGUCACAAACAAGCACGCUAUUU\
GCAAAAAGAUUGUGAAACUCCACAAUGAUACCCUUAAAGCCACCACUUAU\
) } def
/len { sequence length } bind def

