CUUGCAUGUAGUGCCACCCAAAGGUUCUGACCCUAAUGUACAAGAACUCCUGUAUCAAGCUUACAAGAGUAUCCUUACUGAACCAGCACACUAUGUUAUACC ACUUUGUUCAAGAACCAAAACCCGGUCAAAUUUACCUUGAGGUUACUGAAGA\
) } def
/len { sequence length } bind def

