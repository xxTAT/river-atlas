ACCCACACGUACAACUGUUGAGUGCUUUCAGGAGUUUGUCGUAAAUAACACAACUGCACAGUAUAUCUUCUCGACUAUCAAUGCCUUACCUGACAUUAAGUGUGACAUUGUA UUUGGUUUACAAUCACAUUGUGUAUGUUGGUGAUCCUUAUCAGUUACCUUCACCUAGAACUAUGCUUACGUCUGGCCAGCUU\
) } def
/len { sequence length } bind def

