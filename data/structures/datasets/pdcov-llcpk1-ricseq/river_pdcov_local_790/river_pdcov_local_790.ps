UCUAAGAAGAAAAGGUAUACCGACGACCAACCAACACCGUCCUUUAAGUUUAAGGAAUGGUAGUCGAUGACUGGGCCGUUACCAUCCCUGGACAAUAUAUUAUUGCUAUACU UUACAAGUGCUACCUAGGGGCAGCAUAUCUUGUUAGGCCUAUUAUAGUGUACUACUCCAAGCCGAACCCCGUACCUGAGGAU\
) } def
/len { sequence length } bind def

