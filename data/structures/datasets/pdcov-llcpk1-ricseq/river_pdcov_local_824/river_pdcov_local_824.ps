CUAAACCCAAACAGCAGAAGAAACCUAAAAAGGUAACUCUGCCAGCAGACAAACAGGAUUGGGAGUGGGAUGAUGCUUUUGAGAUAAAGCAGGAAUCAGCAGCGUAGACAUCAAUCUAUGUCUGUUAAACCC GAGGGCGCUAUCAUGCAAACUAGGGCUGGCUACUCUAGCACAGAAUCACAUCCCGAUAAUCAACAGUGCUAG\
) } def
/len { sequence length } bind def

