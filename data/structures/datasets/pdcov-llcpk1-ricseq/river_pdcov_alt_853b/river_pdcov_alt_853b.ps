] def

init

% Start Annotations
1 12 9  0 0.9 0.2 omark
14 35 9  1 0.1 0.2 omark

% End Annotations
% switch off outline pairs or bases by removing these lines
drawoutline
drawpairs
drawbases
showpage
end
