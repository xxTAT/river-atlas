UCCACUUAAUUGUGUGCAUAAUGUCUUUAGUAACUUCGACCAGUGGCAUGAUGCCAAGUUUGGUUUCACCCCCGUCAACAAU AGAUGGUAAUGCUGUGUCUUUACCUGAAAUUAUCUCACGUGGCUUUGGCAUCCGUACUAUCCGUACAAAGGCUAUGACCUACUGUCGCGUUGGUCAGUGUGUGCAAUCUGCA\
) } def
/len { sequence length } bind def

