AGCGGUCGAUUCACUUUGUGUGAAAGCCUCCACUGCUUAUAGCAAUGACAAAUGUUCACGCAUCAUACCACAGCGUGCUCGUGUUGAGUGUU UAAUGUUCAGGUUGAUAAUGGUUCAAGCAUUAAUCGCAGGCAAUUGGAUGUUGUGCGUAUGUUUUUGGCUAAAAAUCCUAGGUGGUCAAAGGCUGUUUUUAU\
) } def
/len { sequence length } bind def

