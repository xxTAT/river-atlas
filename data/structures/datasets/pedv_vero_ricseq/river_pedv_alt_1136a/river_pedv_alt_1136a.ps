CGACAAAGUGUUACAACAGUGGAGGUUGUGCUAUGCAAUAUGUUUACGAACCCACUUACUACAUUCUUAAUGUUACUAGUGCUGGUGAGGAUGGUAUUUCUUAUCAACCCUGUACAGCUAAU ACCUCUGGGUGCUAUCCAAGUACCCUAUUAUUGUUUUCUUAAAGUGGAUACUUACAACUCCACUGUUUAUAAAUUCUUGGCU\
) } def
/len { sequence length } bind def

