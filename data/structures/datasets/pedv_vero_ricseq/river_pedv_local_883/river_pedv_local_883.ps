/sequence { (\
AAUGUAUUUGCUACUGAGCCCAAUGGCCACAUACCAGAAGGUUUUAGUUUUAAUAAUUGGUUUCUUUUGUCCAAUGAUUCCACUUUGGUGCAUGGUAAGGUGGUUUCCAACC GUUGCUUUUGACCUUGACGAUGGUUUUUACCGUAUUUCCUCUACAAACCUUCUGAGUCAUGAACAGCCAACUUCUUUUGUUA\
) } def
/len { sequence length } bind def

