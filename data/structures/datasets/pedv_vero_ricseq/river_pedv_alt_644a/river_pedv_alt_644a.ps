AAAUGUAGAGUCUGAAGUUGAGGAAGUUGCCGCAACCUUGUCCUUUAUUAAAGAUACACCUUCCACAGUUACUAAGGAUCCUUUUGCUUUUG CUCUGACUAAGGACCUACACACACUUAAGAUUACCUGUUCUGUAGUCUGUGGUUGUGGUACUGGUGAACGUAUCUAUGAGGGUUGUGCUUUUCGUAUGACGCCAACUUUGGAACCGUUCCCA\
) } def
/len { sequence length } bind def

