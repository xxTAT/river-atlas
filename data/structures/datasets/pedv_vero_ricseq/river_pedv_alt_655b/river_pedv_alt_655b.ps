/sequence { (\
ACAGAGGAGGCAAUAAUAAUAACAAUAACAAGUCUCGUAACCAGUCCAAGAACAGAAACCAGUCAAAUGACC UUGCUCUUUGGUGGUAAUGUGGCUGUUCGCGAGCUAGCGGACUCUUACGAGAUUACAUACAAUUAUAAAAUGACUGUGCCAAAGUCUGAUCCAAAUGUUGAG\
) } def
/len { sequence length } bind def

