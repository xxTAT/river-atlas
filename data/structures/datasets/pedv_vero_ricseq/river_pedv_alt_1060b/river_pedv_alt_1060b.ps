CCUGCCCACUAUGACACAGCUCAACCUUAAAUAUGCUAUAAGUGGCAAAGAACGUGCACGCACAGUGGGUGGUGUUUCGCUUUUGUCAACCAUGACUACUCG CAUGAUUUCAGCCAUGAUUUUAGGCUCUAAGCACACCACAUGCUGCAGUUCCACUGACCGCUUCUUCAGGUUGUGCAAUGAAUUGGCUCAAGUCCUUACUGA\
) } def
/len { sequence length } bind def

