/sequence { (\
UGUUAAAGAGGCUAUUAGUCAAACUUCUAAGGGUUUGAACACUGUGGCUCAUGCGCUUACCAAGGUCCAAGAGGUUGUUAAU AAGUAAUCCCAGAUUACAUCGAUGUUAACCAAACACUUGAUGAGAUUUUAGCUUCUCUGCCC\
) } def
/len { sequence length } bind def

